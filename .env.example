# ModelArena configuration (copy to .env for local dev; set in App Platform for deploy)

# REQUIRED for real inference. Your DigitalOcean token works as the bearer.
# Omit to run in mock mode (deterministic local output, no network/cost).
DO_API_TOKEN=

# Optional overrides (defaults shown)
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Observability
# LOG_LEVEL=info   # debug | info | warn | error  (structured JSON logs)
# LOG_HTTP=true    # log each request (method/path/status/duration)

# Anti-abuse / cost guards (App Platform defaults; tune for prod)
# MAX_MODELS_PER_RUN=8
# MAX_PROMPT_CHARS=8000
# MAX_MAX_TOKENS=4096
# DAILY_TOKEN_BUDGET=400000
# RUNS_PER_MIN=6
# RUNS_PER_DAY=60
